# Скопируйте этот файл в .env и заполните. Файл .env никому не показывайте.

# Токен от @BotFather (выглядит как 1234567890:AAE...)
BOT_TOKEN=

# Ваш Telegram ID — куда приходят заявки и вопросы. Узнать: напишите боту /myid
# Несколько человек — через запятую: 123456789, 987654321
ADMIN_IDS=

# Адрес сайта, когда он будет опубликован (без слэша в конце). Пока пусто — кнопки на сайт не показываются.
SITE_URL=

# Та же ссылка Google Apps Script, что и в site/assets/js/app.js — заявки из бота попадут в ту же таблицу
LEADS_URL=
